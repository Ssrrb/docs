{
  "$description": "Maps every Penpot component to its implementation target in the VS Code fork. Native first; webview and core targets carry a justification. penpotId is filled by the component-mapper agent once the library exists.",
  "designSystemVersion": "0.1.0",
  "fork": "obra-studio/vscode",
  "extension": "extensions/obra-studio",
  "webviewRoot": "extensions/obra-studio/webview",
  "components": [
    { "component": "Button", "penpotId": null, "variants": ["kind", "size", "state"], "tokens": ["accent.solid", "accent.solid-hover", "accent.on", "focus.ring"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/Button.tsx", "justification": "Domain screens render inside webviews; workbench-level actions keep native workbench buttons." },
    { "component": "IconButton", "penpotId": null, "variants": ["size", "state"], "tokens": ["text.secondary", "bg.hover", "focus.ring"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/IconButton.tsx", "justification": "Tooltip and accessible name belong to the domain surface." },
    { "component": "StateChip", "penpotId": null, "variants": ["tone"], "tokens": ["success.subtle-bg", "warning.subtle-bg", "danger.subtle-bg", "text.secondary", "border.subtle"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/StateChip.tsx", "justification": "Document states are domain data; no workbench equivalent." },
    { "component": "MoneyCell", "penpotId": null, "variants": [], "tokens": ["text.primary", "danger.solid"], "target": "webview", "scope": "tables", "implementation": "webview/components/MoneyCell.tsx", "justification": "Tabular numbers and locale formatting are domain concerns." },
    { "component": "DataTable", "penpotId": null, "variants": ["density"], "tokens": ["bg.surface", "bg.hover", "bg.selected", "border.subtle"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/DataTable.tsx", "justification": "Editable domain tables with cell types exceed a TreeView; the budget grid embeds the calculation engine." },
    { "component": "SummaryPanel", "penpotId": null, "variants": [], "tokens": ["bg.raised", "border.subtle", "text.secondary"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/SummaryPanel.tsx", "justification": "Document totals and control boxes are domain content." },
    { "component": "PageHeader", "penpotId": null, "variants": [], "tokens": ["bg.app", "text.primary", "accent.solid"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/PageHeader.tsx", "justification": "Sits inside the editor-area webview content." },
    { "component": "DocumentHeader", "penpotId": null, "variants": [], "tokens": ["bg.app", "text.primary", "border.subtle"], "target": "webview", "scope": "document editors", "implementation": "webview/components/DocumentHeader.tsx", "justification": "Type, number and state chip are domain data." },
    { "component": "ActionBar", "penpotId": null, "variants": [], "tokens": ["bg.surface", "border.subtle", "accent.solid", "danger.solid"], "target": "webview", "scope": "document editors", "implementation": "webview/components/ActionBar.tsx", "justification": "Shows only the transitions the document state allows; domain state machine." },
    { "component": "Toolbar", "penpotId": null, "variants": [], "tokens": ["bg.app", "border.subtle", "border.control"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/Toolbar.tsx", "justification": "Search and filters are domain controls inside the webview." },
    { "component": "Trees and chrome", "penpotId": null, "variants": [], "tokens": ["bg.surface", "bg.hover", "bg.selected", "text.primary"], "target": "core", "scope": "workbench shell", "implementation": "members below", "justification": "The shell is the fork; members map individually." },
    { "component": "TreeRow", "penpotId": null, "variants": ["state"], "tokens": ["bg.hover", "bg.selected", "text.primary", "text.secondary"], "target": "native", "scope": "project explorer", "implementation": "TreeItem via vscode.window.createTreeView", "justification": "VS Code tree views are the native surface for the explorer." },
    { "component": "SegmentedControl", "penpotId": null, "variants": ["state"], "tokens": ["bg.hover", "bg.selected", "text.primary"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/SegmentedControl.tsx", "justification": "En curso / Terminados groupings are domain views." },
    { "component": "Tabs", "penpotId": null, "variants": ["state"], "tokens": ["bg.app", "text.primary"], "target": "native", "scope": "editor area", "implementation": "native editor tabs; no custom tab strip", "justification": "Documents open as editors; the workbench owns the tab strip." },
    { "component": "ActivityBar", "penpotId": null, "variants": [], "tokens": ["bg.surface", "text.primary"], "target": "core", "scope": "workbench shell", "implementation": "view containers registered by the extension; stock activity bar", "justification": "Company navigation maps to view containers; no shell replacement." },
    { "component": "StatusBar", "penpotId": null, "variants": [], "tokens": ["bg.surface", "text.primary"], "target": "core", "scope": "workbench shell", "implementation": "vscode.window.createStatusBarItem", "justification": "Contextual project and document info is a native status bar concern." },
    { "component": "FormField", "penpotId": null, "variants": ["state"], "tokens": ["bg.raised", "border.control", "focus.ring", "danger.solid"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/FormField.tsx", "justification": "Domain forms live in webviews; short command-style inputs use native InputBox and Quick Pick." },
    { "component": "EmptyState", "penpotId": null, "variants": [], "tokens": ["bg.app", "text.muted", "accent.solid"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/EmptyState.tsx", "justification": "Sidebar-level emptiness may use a native welcome view; in-content emptiness is webview." },
    { "component": "InlineBanner", "penpotId": null, "variants": ["tone"], "tokens": ["success.subtle-bg", "warning.subtle-bg", "danger.subtle-bg", "border.subtle"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/InlineBanner.tsx", "justification": "In-content messaging is part of the domain surface." },
    { "component": "Dialog", "penpotId": null, "variants": ["size"], "tokens": ["bg.raised", "border.subtle", "shadow.md"], "target": "webview", "scope": "domain forms", "implementation": "webview/components/Dialog.tsx", "justification": "Domain forms need focus trapping inside the webview; plain confirmations use native dialogs." },
    { "component": "Menu", "penpotId": null, "variants": [], "tokens": ["bg.raised", "border.subtle", "danger.solid"], "target": "webview", "scope": "domain screens", "implementation": "webview/components/Menu.tsx", "justification": "Row menus inside webviews; native surfaces use native context menus." },
    { "component": "Toast", "penpotId": null, "variants": ["tone"], "tokens": ["bg.raised", "border.subtle", "text.primary"], "target": "native", "scope": "confirmations", "implementation": "vscode.window.showInformationMessage with undo action", "justification": "Native notifications carry severity and actions; webview-local feedback stays inline." },
    { "component": "Lightbox", "penpotId": null, "variants": [], "tokens": ["bg.inset", "text.primary"], "target": "webview", "scope": "evidence viewer", "implementation": "webview/components/Lightbox.tsx", "justification": "Certificate evidence needs an in-page viewer with counter and keyboard arrows." }
  ]
}
