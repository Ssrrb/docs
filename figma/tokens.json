{
  "meta": {
    "name": "Obra Studio · tokens",
    "version": "1.0.0",
    "modes": ["dark", "light"],
    "defaultMode": "dark",
    "note": "Semantic roles for the Figma variable collection. Values were computed in OKLCH; hex is the creation value. contrast.report holds measured WCAG pairs.",
    "measuredOn": "2026-10-06"
  },
  "color": {
    "roles": {
      "bg/app":             { "dark": "#0e1217", "light": "#f2f3f5" },
      "bg/surface":         { "dark": "#15191e", "light": "#fdfdfe" },
      "bg/raised":          { "dark": "#1b2026", "light": "#ffffff" },
      "bg/inset":           { "dark": "#090c11", "light": "#ebedef" },
      "bg/hover":           { "dark": "#21262c", "light": "#e6e8eb" },
      "bg/selected":        { "dark": "#202f42", "light": "#d8e6f9" },
      "text/primary":       { "dark": "#e6e8eb", "light": "#20242a" },
      "text/secondary":     { "dark": "#b4b8bc", "light": "#52565b" },
      "text/muted":         { "dark": "#8b9095", "light": "#606368" },
      "border/subtle":      { "dark": "#2a2e34", "light": "#d8dbde" },
      "border/control":     { "dark": "#646971", "light": "#7c8186" },
      "accent/solid":       { "dark": "#75aef5", "light": "#1f68bc" },
      "accent/solid-hover": { "dark": "#69a1e8", "light": "#0859ac" },
      "accent/solid-press": { "dark": "#5d94da", "light": "#004a9c" },
      "accent/on":          { "dark": "#080e16", "light": "#fdfdfe" },
      "focus/ring":         { "dark": "#6fa7ee", "light": "#1f68bc" },
      "danger/solid":       { "dark": "#ba2b28", "light": "#a20711" },
      "danger/on":          { "dark": "#ffffff", "light": "#ffffff" },
      "success/subtle-bg":   { "dark": "#102b17", "light": "#dcf7e1" },
      "success/subtle-text": { "dark": "#a0dcac", "light": "#085023" },
      "warning/subtle-bg":   { "dark": "#362607", "light": "#fff0d0" },
      "warning/subtle-text": { "dark": "#f4ce90", "light": "#694500" },
      "danger/subtle-bg":    { "dark": "#401d1a", "light": "#ffeae5" },
      "danger/subtle-text":  { "dark": "#febab2", "light": "#8d1b19" }
    },
    "state": {
      "draft":   { "bg": "bg/hover",          "text": "text/secondary",     "icon": "pencil-line" },
      "pending": { "bg": "warning/subtle-bg", "text": "warning/subtle-text", "icon": "send" },
      "success": { "bg": "success/subtle-bg", "text": "success/subtle-text", "icon": "circle-check" },
      "closed":  { "bg": "transparent",       "text": "text/muted", "border": "border/subtle", "icon": "archive" },
      "danger":  { "bg": "danger/subtle-bg",  "text": "danger/subtle-text",  "icon": "circle-x" }
    },
    "rules": [
      "Roles, never raw values, in components and frames.",
      "One color, one meaning; the accent means interactive.",
      "State never by color alone; the chip carries an icon and a Spanish label.",
      "Both modes exist; dark is the default."
    ]
  },
  "typography": {
    "families": {
      "ui": "Inter, system-ui, sans-serif",
      "mono": "JetBrains Mono, ui-monospace, monospace"
    },
    "roles": {
      "caption":        { "size": 12, "lineHeight": 16, "weight": 400 },
      "caption-strong": { "size": 12, "lineHeight": 16, "weight": 500 },
      "body":           { "size": 13, "lineHeight": 18, "weight": 400 },
      "body-strong":    { "size": 13, "lineHeight": 18, "weight": 500 },
      "table-cell":     { "size": 13, "lineHeight": 18, "weight": 400, "tabular": true },
      "table-header":   { "size": 12, "lineHeight": 16, "weight": 500 },
      "title-sm":       { "size": 14, "lineHeight": 20, "weight": 500 },
      "title-md":       { "size": 16, "lineHeight": 24, "weight": 600 },
      "title-lg":       { "size": 20, "lineHeight": 26, "weight": 600 },
      "display":        { "size": 24, "lineHeight": 30, "weight": 600 },
      "button":         { "size": 13, "lineHeight": 18, "weight": 500 },
      "mono":           { "size": 12, "lineHeight": 16, "weight": 400, "family": "mono" }
    },
    "rules": [
      "Money and quantity styles use tabular numbers.",
      "Fewer sizes and weights; hierarchy comes from the scale, not from new values."
    ]
  },
  "space": {
    "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48,
    "rule": "The gap between groups is at least twice the gap within a group."
  },
  "radius": {
    "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 12, "full": 999,
    "rule": "Concentric: when a rounded surface nests, outer = inner + the gap between them."
  },
  "shadow": {
    "sm": "0 1px 2px oklch(0 0 0 / 0.10)",
    "md": "0 4px 12px -2px oklch(0 0 0 / 0.16), 0 1px 3px oklch(0 0 0 / 0.10)",
    "lg": "0 16px 32px -8px oklch(0 0 0 / 0.24), 0 4px 12px -4px oklch(0 0 0 / 0.12)",
    "rule": "Shadows for elevation, borders for structure."
  },
  "motion": {
    "duration": { "press": 120, "fast": 150, "base": 200, "slow": 280 },
    "easing": {
      "out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "inOut": "cubic-bezier(0.77, 0, 0.175, 1)"
    },
    "pressScale": 0.96,
    "enterOffset": 8,
    "rules": [
      "Only transform, opacity and filter animate.",
      "Keyboard-triggered interactions do not animate.",
      "Every animated state change keeps a static cue.",
      "Reduced motion replaces movement with an opacity crossfade."
    ]
  },
  "layout": {
    "window": { "width": 1440, "height": 900 },
    "activityBar": 48,
    "sidebar": 260,
    "statusBar": 24,
    "toolbar": 40,
    "tabs": 36,
    "contentPadding": 24
  },
  "contrast": {
    "report": [
      { "mode": "dark", "pair": "text/primary on bg/app", "ratio": 15.30, "need": 4.5 },
      { "mode": "dark", "pair": "text/secondary on bg/app", "ratio": 9.40, "need": 4.5 },
      { "mode": "dark", "pair": "text/muted on bg/app", "ratio": 5.82, "need": 4.5 },
      { "mode": "dark", "pair": "text/primary on bg/selected", "ratio": 11.09, "need": 4.5 },
      { "mode": "dark", "pair": "text/secondary on bg/hover", "ratio": 7.64, "need": 4.5 },
      { "mode": "dark", "pair": "accent/on on accent/solid", "ratio": 8.42, "need": 4.5 },
      { "mode": "dark", "pair": "accent/on on accent/solid-hover", "ratio": 7.26, "need": 4.5 },
      { "mode": "dark", "pair": "accent/on on accent/solid-press", "ratio": 6.23, "need": 4.5 },
      { "mode": "dark", "pair": "focus/ring on bg/app", "ratio": 7.58, "need": 3.0 },
      { "mode": "dark", "pair": "border/control on bg/app", "ratio": 3.42, "need": 3.0 },
      { "mode": "dark", "pair": "success/subtle-text on success/subtle-bg", "ratio": 9.67, "need": 4.5 },
      { "mode": "dark", "pair": "warning/subtle-text on warning/subtle-bg", "ratio": 9.83, "need": 4.5 },
      { "mode": "dark", "pair": "danger/subtle-text on danger/subtle-bg", "ratio": 9.15, "need": 4.5 },
      { "mode": "dark", "pair": "white on danger/solid", "ratio": 6.04, "need": 4.5 },
      { "mode": "light", "pair": "text/primary on bg/surface", "ratio": 15.31, "need": 4.5 },
      { "mode": "light", "pair": "text/secondary on bg/surface", "ratio": 7.33, "need": 4.5 },
      { "mode": "light", "pair": "text/muted on bg/surface", "ratio": 5.91, "need": 4.5 },
      { "mode": "light", "pair": "accent/on on accent/solid", "ratio": 5.56, "need": 4.5 },
      { "mode": "light", "pair": "accent/on on accent/solid-hover", "ratio": 6.82, "need": 4.5 },
      { "mode": "light", "pair": "accent/on on accent/solid-press", "ratio": 8.41, "need": 4.5 },
      { "mode": "light", "pair": "focus/ring on bg/surface", "ratio": 5.48, "need": 3.0 },
      { "mode": "light", "pair": "border/control on bg/surface", "ratio": 3.89, "need": 3.0 },
      { "mode": "light", "pair": "success/subtle-text on success/subtle-bg", "ratio": 8.39, "need": 4.5 },
      { "mode": "light", "pair": "warning/subtle-text on warning/subtle-bg", "ratio": 7.59, "need": 4.5 },
      { "mode": "light", "pair": "danger/subtle-text on danger/subtle-bg", "ratio": 7.87, "need": 4.5 },
      { "mode": "light", "pair": "white on danger/solid", "ratio": 8.18, "need": 4.5 }
    ],
    "rule": "Never report a contrast value that was not measured. A pair that fails is reported, not repainted."
  }
}
